# Java 主后端
APP_ENV=development
SERVER_PORT=8080
DATABASE_URL=sqlite:///./pom.db
AGENT_SERVICE_BASE_URL=http://localhost:8000

# Python Agent 服务
AGENT_PORT=8000

# LLM 模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
# 可选：报告写作与复核单次等待上限（秒，60–600，默认 180）；整篇报告输出远长于研究轮次
# LLM_REPORT_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=1800
# 可选：支持图片输入的模型名单（逗号分隔），原页视觉工具只对这些模型开放
# DEEPSEEK_VISION_MODELS=deepseek-flash,deepseek-v4-flash-vision-exp

# 可选数据/搜索供应商
SEARCH_API_KEY=
MARKET_DATA_API_KEY=
