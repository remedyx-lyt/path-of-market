# Java 主后端
APP_ENV=development
SERVER_PORT=8080
DATABASE_URL=sqlite:///./pom.db
AGENT_SERVICE_BASE_URL=http://localhost:8000

# Python Agent 服务
AGENT_PORT=8000

# LLM 模型（推荐 DeepSeek：项目按它调试，演示与真实验收均用 deepseek-flash）
# 默认 DeepSeek，只填密钥即可；下面的 DEEPSEEK_* 旧写法继续有效。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 换服务商：填 LLM_PROVIDER（deepseek / openai / openai-compatible）、LLM_API_KEY、LLM_MODEL；
# openai-compatible（通义、Kimi、OpenRouter 等 Chat Completions 格式服务）还要填 LLM_BASE_URL。
# 模型必须支持工具调用；只能经 OpenAI Responses 接口调工具的模型（如 GPT-6 Astra）暂不支持。
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# 可选：OpenAI 默认发 reasoning_effort=none（新模型调工具要求）；不认此参数的旧模型填 omit
# LLM_REASONING_EFFORT=omit
# 可选：兼容服务只认 max_completion_tokens 时改此项（默认 max_tokens）
# LLM_MAX_TOKENS_FIELD=max_completion_tokens
LLM_TIMEOUT_SECONDS=60
# 可选：报告写作与复核单次等待上限（秒，60–600，默认 180）；整篇报告输出远长于研究轮次
# LLM_REPORT_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=1800
# 完整阅读的分批笔记上限，独立于上面的简单模型报告；撞上长度限制会有界缩批。
LLM_READING_MAX_TOKENS=3600
# 可选：支持图片输入的模型名单（逗号分隔），原页视觉工具只对这些模型开放（DeepSeek 已有默认值，其他服务商默认无）
# LLM_VISION_MODELS=deepseek-flash,deepseek-v4-flash-vision-exp

# 可选数据/搜索供应商
SEARCH_API_KEY=
# M2-7：默认通过Exa公开MCP免费限流入口搜索，无需填写模型密钥或额外key。
# 关闭时，研究模型不再获得公开网页工具；不影响年报/行情工具。
MCP_WEB_ENABLED=true
MCP_SEARCH_URL=https://mcp.exa.ai/mcp?tools=web_search_advanced_exa
MCP_TIMEOUT_SECONDS=45
MARKET_DATA_API_KEY=
