# 本地密钥与配置；只提交不含密钥的示例文件。
.env
.env.*
!.env.example
!.env.*.example

# Python 环境与运行缓存。
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 前端依赖与构建结果；依赖清单和锁文件需要提交。
node_modules/
dist/
.vite/
coverage/

# Java 构建与开发工具缓存。
target/
.gradle/
.idea/
*.iml

# 本地运行数据；保留目录占位文件。
storage/uploads/**
!storage/uploads/.gitkeep
storage/vectorstore/**
!storage/vectorstore/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# 操作系统临时文件。
.DS_Store
Thumbs.db
